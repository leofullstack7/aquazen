# Copia este archivo como ".env" y ajusta los valores antes de desplegar a producción

PORT=3000

# Cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-unica

# Postgres de Supabase. En Vercel es obligatorio uno de estos dos caminos.
# A) URI del pooler (puerto 6543). Preferida si tienes la contraseña de la base.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# B) API de Supabase (si no usas DATABASE_URL). Nunca expongas la service_role en el frontend.
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# En local, si omites A y B se usa SQLite.

# Credenciales del panel admin (solo se usan la PRIMERA vez que se crea la base de datos)
ADMIN_USER=aquazen_admin
ADMIN_PASS="AquaZen#2026"
