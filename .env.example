# Copia este archivo como ".env" y ajusta los valores antes de desplegar a producción

PORT=3000

# Cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-unica

# En Vercel es OBLIGATORIO (Postgres/Neon). En local, si lo omites se usa SQLite.
DATABASE_URL=

# Credenciales del panel admin (solo se usan la PRIMERA vez que se crea la base de datos)
ADMIN_USER=aquazen_admin
ADMIN_PASS="AquaZen#2026"
